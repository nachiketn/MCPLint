{
  "name": "mcpsmell",
  "version": "0.1.0",
  "description": "Architecture linter for Model Context Protocol (MCP) servers",
  "license": "Apache-2.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nachiketn/MCPLint.git"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "linter",
    "static-analysis",
    "sarif"
  ],
  "bin": {
    "mcpsmell": "dist/src/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    },
    "./testing": {
      "types": "./dist/src/testing/rule-tester.d.ts",
      "default": "./dist/src/testing/rule-tester.js"
    }
  },
  "files": [
    "dist/src",
    "!dist/**/*.test.*"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test \"dist/test/**/*.test.js\"",
    "docs": "npm run build && node dist/scripts/gen-rule-docs.js",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "jsonc-parser": "3.3.1"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "prettier": "3.9.10",
    "typescript": "7.0.2"
  }
}
